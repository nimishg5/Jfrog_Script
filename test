"map_function": "CASE WHEN datamodel_trade.reference = 'TRADE_ON_OTC_V2' THEN 
  CASE 
    WHEN exists(product.productStream, 
      x -> x.legType = 'Near' 
      AND exists(x.notionalAmount, n -> n.currency = x.underlying.fxCurrencyPair.currency1)
    ) 
    THEN element_at(
      filter(product.productStream, 
        x -> x.legType = 'Near' 
        AND exists(x.notionalAmount, n -> n.currency = x.underlying.fxCurrencyPair.currency1)
      ), 
      1
    ).notionalAmount.APartyPayerReceiver

    WHEN exists(product.productStream, 
      x -> x.legType = 'Near' 
      AND exists(x.notionalAmount, n -> n.currency = x.underlying.fxCurrencyPair.currency2)
    ) 
    THEN element_at(
      filter(product.productStream, 
        x -> x.legType = 'Near' 
        AND exists(x.notionalAmount, n -> n.currency = x.underlying.fxCurrencyPair.currency2)
      ), 
      1
    ).notionalAmount.APartyPayerReceiver

    ELSE NULL
  END 
END"
