"map_function": "CASE WHEN datamodel_trade.reference = 'TRADE_ON_OTC_V2' THEN 
  CASE 
    WHEN exists(product.productStream, 
      x -> x.legType = 'Near' 
      AND exists(x.notionalAmount, n -> 
        exists(x.underlying, u -> 
          exists(u.fxCurrencyPair, f -> array_contains(f.currency1, n.currency))
        )
      )
    ) 
    THEN element_at(
      filter(product.productStream, 
        x -> x.legType = 'Near' 
        AND exists(x.notionalAmount, n -> 
          exists(x.underlying, u -> 
            exists(u.fxCurrencyPair, f -> array_contains(f.currency1, n.currency))
          )
        )
      ), 
      1
    ).notionalAmount.APartyPayerReceiver

    WHEN exists(product.productStream, 
      x -> x.legType = 'Near' 
      AND exists(x.notionalAmount, n -> 
        exists(x.underlying, u -> 
          exists(u.fxCurrencyPair, f -> array_contains(f.currency2, n.currency))
        )
      )
    ) 
    THEN element_at(
      filter(product.productStream, 
        x -> x.legType = 'Near' 
        AND exists(x.notionalAmount, n -> 
          exists(x.underlying, u -> 
            exists(u.fxCurrencyPair, f -> array_contains(f.currency2, n.currency))
          )
        )
      ), 
      1
    ).notionalAmount.APartyPayerReceiver

    ELSE NULL
  END 
END"
